{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "bc-gordian-ide",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
  "workers_dev": false,
  "preview_urls": false,
  "main": "worker.ts",
  // The playground serves every hostname not named below. The docs and MCP
  // hosts are routed by the Worker on these names; add a route for each
  // once its static assets (/__docs__, /__mcp__) are part of the build.
  "vars": {
    "DOCS_HOSTNAME": "docs.playground.gordianstack.com",
    "MCP_HOSTNAME": "mcp.playground.gordianstack.com",
  },
  "routes": [{ "pattern": "playground.gordianstack.com", "custom_domain": true }],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true },
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "2097d88326364d72b76c6a160327c29e",
    },
  ],
}
